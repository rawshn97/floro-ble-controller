{
  "name": "FloRo Sign Controller",
  "short_name": "FloRo",
  "description": "Control your FloRo neon sign over Bluetooth",
  "start_url": "/sign-controller/",
  "scope": "/sign-controller/",
  "id": "/sign-controller/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#020D0A",
  "theme_color": "#020D0A",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/sign-controller/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sign-controller/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/sign-controller/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
